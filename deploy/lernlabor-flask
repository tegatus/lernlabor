#!/usr/bin/env bash
# Führt Verwaltungsbefehle der App als Dienstkonto mit der Server-Konfiguration aus, z. B.:
#   sudo lernlabor-flask create-lp vorname.name "Vorname Name"
#   sudo lernlabor-flask init-db
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "Bitte mit sudo ausführen." >&2; exit 1; }
cd __APP_DIR__
# Konfiguration als Dienstkonto einlesen (die Datei ist für die Gruppe lernlabor lesbar)
exec runuser -u lernlabor -- bash -c 'set -a; . /etc/lernlabor/lernlabor.env; set +a; exec .venv/bin/flask --app run "$@"' \
  lernlabor-flask "$@"
